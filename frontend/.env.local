#!/bin/bash
# Setup script for ShipGuard environment variables

# Read Vercel token if available
if [ -f "/home/ubuntu/.hermes/secrets/vercel-new.token" ]; then
    VERCEL_TOKEN=$(cat /home/ubuntu/.hermes/secrets/vercel-new.token)
    echo "Found Vercel token"
fi

# Supabase project reference (from session memory)
SUPABASE_PROJECT_REF="ervkqbncvboqsgvwjnpq"
SUPABASE_URL="https://${SUPABASE_PROJECT_REF}.supabase.co"

# Load pooler credentials if available
if [ -f "/home/ubuntu/.hermes/secrets/supabase-pooler.env" ]; then
    echo "Loading Supabase pooler credentials..."
    source /home/ubuntu/.hermes/secrets/supabase-pooler.env
fi

# Set environment variables for local development
echo "Setting up environment variables..."

# Create .env.local with actual values (NOT COMMITED)
cat > /home/ubuntu/shipguard/frontend/.env.local << EOF
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio-next.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61997
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Studio Next
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN
NEXT_PUBLIC_VAULT_CONTRACT=0x17F1B041803d5f1B188F34b47EE727152885356C
NEXT_PUBLIC_CONDITION_CONTRACT=0x3F3A37d949C5fD03E67C758C38d214645D94f721
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=\${NEXT_PUBLIC_SUPABASE_ANON_KEY}
NEXT_PUBLIC_GITHUB_VERIFY_CONTRACT=0x0000000000000000000000000000000000000000
EOF

echo "Created .env.local"
echo "⚠️  You need to set NEXT_PUBLIC_SUPABASE_ANON_KEY manually"
echo "   Get it from: ${SUPABASE_URL}/project/${SUPABASE_PROJECT_REF}"
echo "   Settings → Authentication → Configuration → Connection strings"